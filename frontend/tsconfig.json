{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": false,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "pip install fastapi uvicorn6.0",
  },
  "include": [
    "src/**/*",
    "vite.config.js",
    "api/**/*",
    "../backend/bot",
    "../backend/ya_mayorista_ai_venv",
  ],
  "exclude": ["node_modules", "dist"],
}
